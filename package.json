{
  "name": "@power-assert/monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "power-assert monorepo",
  "keywords": [],
  "author": {
    "name": "Takuto WADA",
    "email": "takuto.wada@gmail.com",
    "url": "https://github.com/twada"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@twada/benchmark-commits": "^0.5.0",
    "@types/convert-source-map": "^2.0.3",
    "@types/estree": "^1.0.9",
    "@types/multi-stage-sourcemap": "^0.3.5",
    "@types/node": "^26.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "prepack": "npm run build:dist && npm run test:dist",
    "build:dist": "npm run lint && npm run clean:all && npm run compile && npm run build:swc",
    "clean:all": "npm run build:clean --workspaces --if-present",
    "lint": "oxlint packages",
    "fmt": "oxfmt packages",
    "fmt:check": "oxfmt --check packages",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "check": "npm run lint && npm run fmt:check && npm run typecheck",
    "compile": "tsc --build tsconfig.build.json",
    "build:swc": "npm run test -w swc-plugin-power-assert && npm run build -w swc-plugin-power-assert",
    "test:dist": "node --test --test-reporter=dot 'packages/**/dist/**/*_test.mjs'",
    "test:prove": "prove --exec 'node --conditions=power-assert-dev --test --test-reporter=tap' -r packages --ext=_test.mts",
    "test:dev": "node --conditions=power-assert-dev --test --test-reporter=dot 'packages/**/src/**/__tests__/**/*_test.mts'",
    "test": "npm run check && npm run test:dev"
  },
  "workspaces": [
    "packages/transpiler-core",
    "packages/transpiler",
    "packages/runtime",
    "packages/node",
    "packages/esbuild-plugin-power-assert",
    "packages/rollup-plugin-power-assert",
    "packages/swc-plugin-power-assert",
    "packages/integration-tests"
  ]
}
